# ==========================================
# CONFIGURACIÓN DE AMBIENTE LOCAL
# ==========================================
# Este archivo contiene las variables de entorno necesarias para desarrollo local.
# Copia este archivo como .env y configura tus credenciales.

# ==========================================
# CONFIGURACIÓN DE SECRETOS (JWT)
# ==========================================
# Esta variable simula el secreto de AWS Secrets Manager para firmar tokens JWT en local.
# El nombre se deriva de: SECRET_PRI_{STAGE}_{SHORT_REGION} (todo mayúsculas, guiones por guiones bajos)
# Ejemplo para stage=dev, region=us-west-2: SECRET_PRI_DEV_USW2

SECRET_PRI_DEV_USW2=tu-secreto-jwt-local-aqui

# ==========================================
# CONFIGURACIÓN DE EMAIL (SMTP)
# ==========================================
# Estas credenciales se usan para envío de emails en ambiente local.
# En ambientes dev/prod se obtienen automáticamente desde AWS Secrets Manager.

# Host del servidor SMTP (ej: smtp.gmail.com, smtp.office365.com)
EMAIL_HOST=smtp.gmail.com

# Puerto SMTP (587 para TLS, 465 para SSL, 25 sin encriptación)
EMAIL_PORT=587

# Usar SSL/TLS (true para puerto 465, false para otros)
EMAIL_SECURE=false

# Usuario/email para autenticación SMTP
EMAIL_USER=tu-email@gmail.com

# Contraseña de la aplicación o contraseña del email
# IMPORTANTE para Gmail: Debes usar una "Contraseña de aplicación" en lugar de tu contraseña normal
# Genera una en: https://myaccount.google.com/apppasswords
EMAIL_PASSWORD=tu-contraseña-de-aplicacion

# ==========================================
# NOTAS IMPORTANTES
# ==========================================
# 1. NUNCA subas el archivo .env al repositorio (debe estar en .gitignore)
# 2. Para Gmail, Office365 u otros proveedores, usa contraseñas de aplicación
# 3. Asegúrate de que la cuenta permita el acceso SMTP
# 4. Verifica que el puerto no esté bloqueado por firewall
