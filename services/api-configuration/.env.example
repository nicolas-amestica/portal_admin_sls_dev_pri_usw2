# Configuración para desarrollo local

# AWS Configuration
AWS_REGION=us-west-2
AWS_PROFILE=pa-dev

# DynamoDB Tables
DYNAMODB_CONFIG_TABLE=portal-admin-config-dev-pri-usw2
DYNAMODB_USER_TABLE=portal-admin-user-dev-pri-usw2

# Application
STAGE=dev
PORT=3001

# Para usar DynamoDB Local (opcional)
# AWS_ENDPOINT_URL=http://localhost:8000
# AWS_ACCESS_KEY_ID=local
# AWS_SECRET_ACCESS_KEY=local
